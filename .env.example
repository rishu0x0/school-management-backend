# .env.example
# Copy to .env and fill in real values. NEVER commit .env to git.
# All values sourced from: Supabase Dashboard -> Project Settings -> Database

# ============================================================
# Supabase Connection Strings
# ============================================================

# Direct connection (port 5432) — used by Go backend (pgxpool reads DATABASE_URL)
# Find at: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Direct)
# Format: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# OR for older Supabase projects: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:<your-db-password>@db.<your-project-ref>.supabase.co:5432/postgres

# Supabase project URL — used for storage, REST, and admin operations
# Find at: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase service role key — bypasses RLS; used by Go backend for all DB operations
# Find at: Supabase Dashboard -> Project Settings -> API -> service_role (secret)
# WARNING: Never expose this key in client-side code or Flutter app
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase anon key — subject to RLS; used for testing RLS policies only
# Find at: Supabase Dashboard -> Project Settings -> API -> anon (public)
SUPABASE_ANON_KEY=eyJ...

# ============================================================
# Go Backend Configuration
# ============================================================

# JWT secret for signing access tokens (generate with: openssl rand -hex 32)
JWT_SECRET=<32-byte-random-hex-string>

# JWT access token expiry (24h as per PRD)
JWT_ACCESS_EXPIRY=24h

# Go server port
PORT=8080

# Environment (development | production)
ENV=development

# ============================================================
# MSG91 OTP Service
# ============================================================

# Auth token — used by Go backend to authenticate all MSG91 REST API calls
# Find at: MSG91 Dashboard -> API -> Auth Key
MSG91_AUTH_TOKEN=509550TgxMsbOhd69e240dcP1

# Widget ID — identifies the pre-configured OTP widget in MSG91 dashboard
# Used by the Go backend's /send-otp and /retry-otp flows
MSG91_WIDGET_ID=3664716e6457393138393133

# ============================================================
# Connection Pool Notes (pgxpool)
# ============================================================
# Use DATABASE_URL (port 5432 direct connection) — pgxpool manages its own pooling
# Set MaxConns: 10 to stay within Supabase free tier limit (60 total connections)
# PgBouncer (port 6543) is available if the connection limit is hit
